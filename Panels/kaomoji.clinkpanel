{"id":"panel-kaomoji","name":"Kaomoji","icon":"face.smiling","summary":"Tap to insert a kaomoji","placement":"default","enabled":true,"source":"def view(state):\n    faces = [\"(╯°□°)╯︵ ┻━┻\", \"¯\\_(ツ)_/¯\", \"(づ｡◕‿‿◕｡)づ\", \"ಠ_ಠ\", \"(╥﹏╥)\", \"ᕕ( ᐛ )ᕗ\", \"(◕‿◕)\", \"(ノ◕ヮ◕)ノ*:･ﾟ✧\"]\n    rows = []\n    for f in faces:\n        rows.append(button(f, insert=f))\n    return vstack([text(\"Kaomoji\", size=16, weight=\"bold\"), grid(rows, columns=2)])"}
